"""
AWS Glue Job: Salesforce Attachment Download - Verification / Reconciliation
==============================================================================
Companion job to glue_sf_attachment_downloader.py. Run this AFTER the
downloader completes for a given input batch to answer two separate
questions:

  (1) MANIFEST RECONCILIATION -- do the SUCCESS + FAILED manifests fully
      account for every row in the original input CSV, with no duplicates
      and no silently-vanished rows?

  (2) S3 REALITY CHECK -- for every row the SUCCESS manifest claims landed
      in S3, does the object actually exist at that key, with the byte size
      the manifest says it has, and a key that matches what the downloader
      would have generated from that row's ParentId/AttachmentId/CreatedDate/
      FileName (catches a manifest that's stale/edited/mismatched vs reality)?

Why both: the downloader's SUCCESS manifest is trustworthy about what IT
observed at upload time (it verified the streamed byte count against
BodyLength before calling a row a success -- see BodyLengthMismatch handling
in the downloader). But it can't tell you if something happened to the
object AFTER upload (deleted by a lifecycle rule, overwritten by an unrelated
process, bucket versioning surprises, etc.), or if the manifest CSV itself
got corrupted/edited/partially written on its way out of Spark. This job
re-derives ground truth independently by hitting S3 directly.

Outputs (all under VERIFICATION_OUTPUT_PATH):
  - summary/<job_name>_<ts>.json
      Single JSON: manifest reconciliation counts + S3 verification counts
      + a breakdown of failure reasons, so you can eyeball pass/fail without
      opening any CSV.
  - discrepancies/manifest/  (CSV)
      Rows from the manifest reconciliation step that are NOT clean:
      MISSING_FROM_MANIFESTS (input row with no matching success/failed row),
      DUPLICATE_IN_SUCCESS, DUPLICATE_IN_FAILED, DUPLICATE_ACROSS_SUCCESS_AND_FAILED.
  - discrepancies/s3/  (CSV)
      SUCCESS-manifest rows where the S3 reality check failed:
      MISSING_IN_S3, SIZE_MISMATCH, KEY_MISMATCH, HEAD_ERROR.

Nothing here mutates S3 or the manifests -- this is read-only, safe to run
repeatedly, and safe to run in parallel with a retry pass against the SAME
manifests (though not against manifests a concurrent run is still writing).

Sampling: for very large batches, checking every SUCCESS row against S3 with
a HEAD request is the single most expensive part of this job (one API call
per row). SAMPLE_RATE lets you check a statistical subset instead of 100%
when you just want ongoing confidence rather than an exhaustive audit --
set it to 1.0 for a full audit (e.g. before a compliance sign-off).

Required Glue job parameters (--arg-name value):
  --INPUT_CSV_PATH             s3://your-bucket/input/attachment_replica.csv
                                (the SAME input the downloader was run against)
  --SUCCESS_OUTPUT_PATH        s3://your-output-bucket/manifests/success/
  --FAILED_OUTPUT_PATH         s3://your-output-bucket/manifests/failed/
  --OUTPUT_BUCKET               your-output-bucket        (where attachments landed)
  --ATTACHMENT_ROOT              sf-attachments            (must match downloader)
  --VERIFICATION_OUTPUT_PATH   s3://your-output-bucket/verification/
  --NUM_PARTITIONS              200
  --THREAD_POOL_SIZE            20                          (concurrent HEAD requests/partition)
  --SAMPLE_RATE                 1.0                          (0.0-1.0; 1.0 = check every SUCCESS row)
"""

import sys
import re
import json
import random
import logging
import itertools
import datetime as dt
from concurrent.futures import ThreadPoolExecutor, FIRST_COMPLETED, wait

import boto3
from botocore.config import Config as BotoConfig
from botocore.exceptions import ClientError

from pyspark.context import SparkContext
from pyspark.sql import SparkSession, Row
from pyspark.sql import functions as F
from pyspark.sql.types import StructType, StructField, StringType, LongType

from awsglue.context import GlueContext
from awsglue.job import Job
from awsglue.utils import getResolvedOptions

# --------------------------------------------------------------------------- #
# Glue / Spark bootstrap
# --------------------------------------------------------------------------- #

ARGS = getResolvedOptions(
    sys.argv,
    [
        "JOB_NAME",
        "INPUT_CSV_PATH",
        "SUCCESS_OUTPUT_PATH",
        "FAILED_OUTPUT_PATH",
        "OUTPUT_BUCKET",
        "ATTACHMENT_ROOT",
        "VERIFICATION_OUTPUT_PATH",
        "NUM_PARTITIONS",
        "THREAD_POOL_SIZE",
        "SAMPLE_RATE",
    ],
)

sc = SparkContext()
glueContext = GlueContext(sc)
spark = glueContext.spark_session
job = Job(glueContext)
job.init(ARGS["JOB_NAME"], ARGS)

logger = glueContext.get_logger()
_executor_log = logging.getLogger("sf_attachment_verifier")

INPUT_CSV_PATH = ARGS["INPUT_CSV_PATH"]
SUCCESS_OUTPUT_PATH = ARGS["SUCCESS_OUTPUT_PATH"]
FAILED_OUTPUT_PATH = ARGS["FAILED_OUTPUT_PATH"]
OUTPUT_BUCKET = ARGS["OUTPUT_BUCKET"]
ATTACHMENT_ROOT = ARGS["ATTACHMENT_ROOT"].strip("/")
VERIFICATION_OUTPUT_PATH = ARGS["VERIFICATION_OUTPUT_PATH"]
NUM_PARTITIONS = int(ARGS["NUM_PARTITIONS"])
THREAD_POOL_SIZE = int(ARGS["THREAD_POOL_SIZE"])
SAMPLE_RATE = float(ARGS["SAMPLE_RATE"])

REQUEST_CONNECT_TIMEOUT = 10
REQUEST_READ_TIMEOUT = 30
MAX_IN_FLIGHT_MULTIPLIER = 2

_INVALID_FS_CHARS = re.compile(r'[\\/:*?"<>|\x00-\x1f]')
MAX_S3_KEY_BYTES = 1024
S3_KEY_SAFETY_MARGIN = 16


def parse_s3_path(s3_path: str):
    if not s3_path.startswith("s3://"):
        raise ValueError(f"Expected an s3:// path, got: {s3_path}")
    without_scheme = s3_path[len("s3://"):]
    bucket, _, prefix = without_scheme.partition("/")
    if not bucket:
        raise ValueError(f"Could not parse bucket from path: {s3_path}")
    return bucket, prefix.strip("/")


def derive_job_name(input_path: str) -> str:
    base = input_path.rstrip("/").split("/")[-1]
    if "." in base:
        base = base.rsplit(".", 1)[0]
    base = re.sub(r"[^A-Za-z0-9._-]", "_", base)
    return base or "unknown_input"


JOB_NAME = derive_job_name(INPUT_CSV_PATH)
VERIFY_BUCKET, VERIFY_PREFIX = parse_s3_path(VERIFICATION_OUTPUT_PATH)


# --------------------------------------------------------------------------- #
# Same key-derivation logic as the downloader -- duplicated deliberately
# (not imported) so this job can independently recompute what a row's S3 key
# SHOULD be and catch a manifest whose S3RelativePath disagrees with what the
# downloader's own logic would have produced.
# --------------------------------------------------------------------------- #

def sanitize_filename(name: str, fallback: str) -> str:
    if not name:
        name = fallback
    name = _INVALID_FS_CHARS.sub("_", name).strip().strip(".")
    return name if name else fallback


def parse_year_month(created_date: str):
    if not created_date:
        now = dt.datetime.utcnow()
        return f"{now.year:04d}", f"{now.month:02d}"
    try:
        cleaned = created_date.replace("Z", "+00:00")
        parsed = dt.datetime.fromisoformat(cleaned[:19])
        return f"{parsed.year:04d}", f"{parsed.month:02d}"
    except Exception:
        now = dt.datetime.utcnow()
        return f"{now.year:04d}", f"{now.month:02d}"


def build_expected_s3_key(root, year, month, parent_id, attachment_id, filename):
    prefix = f"{root}/year={year}/month={month}/{parent_id}/{attachment_id}/"
    budget = MAX_S3_KEY_BYTES - S3_KEY_SAFETY_MARGIN - len(prefix.encode("utf-8"))
    encoded = filename.encode("utf-8")
    if len(encoded) <= budget:
        return prefix + filename
    stem, dot, ext = filename.rpartition(".")
    ext_suffix = f".{ext}" if dot else ""
    stem_budget = max(1, budget - len(ext_suffix.encode("utf-8")))
    truncated_stem = stem.encode("utf-8")[:stem_budget].decode("utf-8", errors="ignore") if dot else \
        filename.encode("utf-8")[:budget].decode("utf-8", errors="ignore")
    return prefix + truncated_stem + ext_suffix


# --------------------------------------------------------------------------- #
# Step 1: MANIFEST RECONCILIATION (pure Spark DataFrame ops, no S3 calls)
# --------------------------------------------------------------------------- #
# Purely checks that the CSVs are internally consistent with each other and
# with the original input -- catches things like a Spark write that got cut
# off, a retry pass whose output got unioned into the wrong manifest folder,
# or speculative-execution duplicates if spark.speculation was accidentally
# left on for a run.

def run_manifest_reconciliation():
    input_schema = StructType([
        StructField("Id", StringType(), True),
        StructField("ParentId", StringType(), True),
        StructField("Name", StringType(), True),
        StructField("IsPrivate", StringType(), True),
        StructField("ContentType", StringType(), True),
        StructField("BodyLength", LongType(), True),
        StructField("OwnerId", StringType(), True),
        StructField("CreatedDate", StringType(), True),
        StructField("CreatedById", StringType(), True),
        StructField("LastModifiedDate", StringType(), True),
        StructField("LastModifiedById", StringType(), True),
        StructField("SystemModstamp", StringType(), True),
        StructField("IsDeleted", StringType(), True),
        StructField("Description", StringType(), True),
        StructField("_corrupt_record", StringType(), True),
    ])

    input_df = (
        spark.read
        .option("header", "true")
        .option("enforceSchema", "false")
        .option("mode", "PERMISSIVE")
        .option("columnNameOfCorruptRecord", "_corrupt_record")
        .schema(input_schema)
        .csv(INPUT_CSV_PATH)
    )
    # Same definition of a "processable" row the downloader used: not a
    # corrupt CSV row, and has a non-null Id. Corrupt/null-Id rows are the
    # downloader's own responsibility to have routed to FAILED with
    # MalformedCsvRow / never emitted at all -- they're out of scope for
    # "did every processable row get a manifest entry".
    input_ids_df = (
        input_df
        .filter(F.col("_corrupt_record").isNull())
        .filter(F.col("Id").isNotNull())
        .select(F.col("Id").alias("AttachmentId"))
        .distinct()
    )
    input_total = input_ids_df.count()

    success_df = spark.read.option("header", "true").csv(SUCCESS_OUTPUT_PATH)
    failed_df = spark.read.option("header", "true").csv(FAILED_OUTPUT_PATH)

    success_ids = success_df.select("AttachmentId").filter(F.col("AttachmentId").isNotNull())
    failed_ids = failed_df.select("AttachmentId").filter(F.col("AttachmentId").isNotNull())

    success_count = success_ids.count()
    failed_count = failed_ids.count()

    # Duplicates WITHIN each manifest.
    dup_success = (
        success_ids.groupBy("AttachmentId").count()
        .filter(F.col("count") > 1)
        .withColumn("IssueType", F.lit("DUPLICATE_IN_SUCCESS"))
    )
    dup_failed = (
        failed_ids.groupBy("AttachmentId").count()
        .filter(F.col("count") > 1)
        .withColumn("IssueType", F.lit("DUPLICATE_IN_FAILED"))
    )

    # An AttachmentId appearing in BOTH manifests is a contract violation --
    # a row should resolve to exactly one terminal state.
    dup_across = (
        success_ids.distinct().join(failed_ids.distinct(), on="AttachmentId", how="inner")
        .withColumn("count", F.lit(2))
        .withColumn("IssueType", F.lit("DUPLICATE_ACROSS_SUCCESS_AND_FAILED"))
    )

    # Input rows with no matching entry in either manifest at all -- these
    # are the ones you can't even see in a FAILED manifest to retry; usually
    # means a partition-level crash that Spark's task retries eventually
    # gave up on (exceeding spark.task.maxFailures) rather than falling
    # through to the downloader's own per-row/per-partition error handling.
    accounted_ids = success_ids.distinct().union(failed_ids.distinct()).distinct()
    missing_df = (
        input_ids_df.join(accounted_ids, on="AttachmentId", how="left_anti")
        .withColumn("count", F.lit(0))
        .withColumn("IssueType", F.lit("MISSING_FROM_MANIFESTS"))
    )

    discrepancies_df = dup_success.unionByName(dup_failed).unionByName(dup_across).unionByName(missing_df)
    discrepancy_count = discrepancies_df.count()

    if discrepancy_count:
        (
            discrepancies_df
            .coalesce(1)
            .write.mode("overwrite").option("header", "true")
            .csv(f"{VERIFICATION_OUTPUT_PATH.rstrip('/')}/discrepancies/manifest/{JOB_NAME}/")
        )

    return {
        "input_total_processable_rows": input_total,
        "success_manifest_rows": success_count,
        "failed_manifest_rows": failed_count,
        "manifest_sum_vs_input_diff": input_total - (success_count + failed_count),
        "duplicate_in_success_count": dup_success.count(),
        "duplicate_in_failed_count": dup_failed.count(),
        "duplicate_across_manifests_count": dup_across.count(),
        "missing_from_manifests_count": missing_df.count(),
        "manifest_reconciliation_clean": discrepancy_count == 0,
    }, success_df


# --------------------------------------------------------------------------- #
# Step 2: S3 REALITY CHECK (per-partition, threaded HEAD requests)
# --------------------------------------------------------------------------- #

VERIFY_RESULT_FIELDS = [
    "AttachmentId", "ParentId", "FileName", "S3RelativePath", "ExpectedKey",
    "ManifestBodyLength", "S3ContentLength", "VerifyStatus", "Detail",
]


def verify_partition(partition_id, rows):
    row_iter = iter(rows)
    try:
        first_row = next(row_iter)
    except StopIteration:
        return
    row_iter = itertools.chain([first_row], row_iter)

    try:
        s3_client = boto3.client(
            "s3",
            config=BotoConfig(
                max_pool_connections=THREAD_POOL_SIZE,
                connect_timeout=REQUEST_CONNECT_TIMEOUT,
                read_timeout=REQUEST_READ_TIMEOUT,
                retries={"max_attempts": 3, "mode": "standard"},
            ),
        )
    except Exception as e:  # noqa: BLE001
        for row in row_iter:
            yield Row(
                AttachmentId=row["AttachmentId"], ParentId=row["ParentId"],
                FileName=row["FileName"], S3RelativePath=row["S3RelativePath"],
                ExpectedKey=None, ManifestBodyLength=row["BodyLength"],
                S3ContentLength=None, VerifyStatus="HEAD_ERROR",
                Detail=f"Partition setup failed: {str(e)[:300]}",
            )
        return

    def verify_row(row) -> Row:
        attachment_id = row["AttachmentId"]
        parent_id = row["ParentId"]
        filename = row["FileName"]
        s3_key = row["S3RelativePath"]
        manifest_body_length = row["BodyLength"]
        created_date = row["CreatedDate"]

        def result(status, detail, s3_len=None, expected_key=None):
            return Row(
                AttachmentId=attachment_id, ParentId=parent_id, FileName=filename,
                S3RelativePath=s3_key, ExpectedKey=expected_key,
                ManifestBodyLength=manifest_body_length, S3ContentLength=s3_len,
                VerifyStatus=status, Detail=detail,
            )

        if not s3_key:
            return result("MISSING_IN_S3", "Manifest row has no S3RelativePath")

        # Recompute the key the downloader SHOULD have produced for this row
        # and flag disagreement -- catches a manifest CSV that's stale, hand-
        # edited, or was regenerated with different ATTACHMENT_ROOT/filename
        # sanitization than what actually wrote the object.
        year, month = parse_year_month(created_date)
        safe_name = sanitize_filename(filename, f"{attachment_id}.bin")
        expected_key = build_expected_s3_key(
            ATTACHMENT_ROOT, year, month, parent_id, attachment_id, safe_name
        )
        key_matches = (expected_key == s3_key)

        try:
            head = s3_client.head_object(Bucket=OUTPUT_BUCKET, Key=s3_key)
        except ClientError as e:
            code = e.response.get("Error", {}).get("Code", "")
            if code in ("404", "NoSuchKey", "NotFound"):
                return result("MISSING_IN_S3", "Object not found in S3", expected_key=expected_key)
            return result("HEAD_ERROR", f"{code}: {str(e)[:300]}", expected_key=expected_key)
        except Exception as e:  # noqa: BLE001
            return result("HEAD_ERROR", str(e)[:300], expected_key=expected_key)

        s3_len = head.get("ContentLength")

        if not key_matches:
            return result("KEY_MISMATCH", "Manifest S3RelativePath disagrees with recomputed key",
                          s3_len=s3_len, expected_key=expected_key)

        if manifest_body_length is not None and s3_len is not None and s3_len != manifest_body_length:
            return result(
                "SIZE_MISMATCH",
                f"Manifest BodyLength={manifest_body_length} but S3 ContentLength={s3_len}",
                s3_len=s3_len, expected_key=expected_key,
            )

        return result("VERIFIED", "OK", s3_len=s3_len, expected_key=expected_key)

    max_in_flight = THREAD_POOL_SIZE * MAX_IN_FLIGHT_MULTIPLIER
    with ThreadPoolExecutor(max_workers=THREAD_POOL_SIZE) as executor:
        in_flight = set()
        for row in itertools.islice(row_iter, max_in_flight):
            in_flight.add(executor.submit(verify_row, row))
        while in_flight:
            done, in_flight = wait(in_flight, return_when=FIRST_COMPLETED)
            for future in done:
                yield future.result()
            for row in itertools.islice(row_iter, len(done)):
                in_flight.add(executor.submit(verify_row, row))


def run_s3_reality_check(success_df):
    check_df = success_df.select(
        "AttachmentId", "ParentId", "FileName", "S3RelativePath",
        "BodyLength", "CreatedDate",
    )
    # BodyLength arrives as a string from the manifest CSV read -- cast back
    # so the numeric comparison against S3's ContentLength is apples-to-apples.
    check_df = check_df.withColumn("BodyLength", F.col("BodyLength").cast(LongType()))

    if SAMPLE_RATE < 1.0:
        check_df = check_df.sample(withReplacement=False, fraction=SAMPLE_RATE, seed=42)
        logger.info(f"SAMPLE_RATE={SAMPLE_RATE}: verifying a sampled subset of SUCCESS rows against S3.")

    check_df = check_df.repartition(NUM_PARTITIONS)

    result_schema = StructType([
        StructField("AttachmentId", StringType(), True),
        StructField("ParentId", StringType(), True),
        StructField("FileName", StringType(), True),
        StructField("S3RelativePath", StringType(), True),
        StructField("ExpectedKey", StringType(), True),
        StructField("ManifestBodyLength", LongType(), True),
        StructField("S3ContentLength", LongType(), True),
        StructField("VerifyStatus", StringType(), True),
        StructField("Detail", StringType(), True),
    ])

    verify_rdd = check_df.rdd.mapPartitionsWithIndex(verify_partition)
    verify_df = spark.createDataFrame(verify_rdd, schema=result_schema).persist()

    total_checked = verify_df.count()
    by_status = {
        r["VerifyStatus"]: r["count"]
        for r in verify_df.groupBy("VerifyStatus").count().collect()
    }
    verified_count = by_status.get("VERIFIED", 0)

    bad_df = verify_df.filter(F.col("VerifyStatus") != "VERIFIED")
    bad_count = bad_df.count()
    if bad_count:
        (
            bad_df.coalesce(1).write.mode("overwrite").option("header", "true")
            .csv(f"{VERIFICATION_OUTPUT_PATH.rstrip('/')}/discrepancies/s3/{JOB_NAME}/")
        )

    verify_df.unpersist()

    return {
        "s3_rows_checked": total_checked,
        "s3_sample_rate_used": SAMPLE_RATE,
        "s3_verified_ok_count": verified_count,
        "s3_status_breakdown": by_status,
        "s3_check_clean": bad_count == 0,
    }


# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #

def main():
    run_start_ts = dt.datetime.utcnow().isoformat()
    logger.info(f"Starting verification for job_name={JOB_NAME}")

    manifest_stats, success_df = run_manifest_reconciliation()
    logger.info(f"Manifest reconciliation: {manifest_stats}")

    success_df = success_df.persist()
    s3_stats = run_s3_reality_check(success_df)
    logger.info(f"S3 reality check: {s3_stats}")
    success_df.unpersist()

    run_end_ts = dt.datetime.utcnow().isoformat()
    try:
        duration = (dt.datetime.fromisoformat(run_end_ts) - dt.datetime.fromisoformat(run_start_ts)).total_seconds()
    except Exception:
        duration = None

    overall_clean = manifest_stats["manifest_reconciliation_clean"] and s3_stats["s3_check_clean"]

    summary = {
        "job_name": JOB_NAME,
        "glue_job_run_name": ARGS["JOB_NAME"],
        "input_csv_path": INPUT_CSV_PATH,
        "success_manifest_path": SUCCESS_OUTPUT_PATH,
        "failed_manifest_path": FAILED_OUTPUT_PATH,
        "attachment_bucket": OUTPUT_BUCKET,
        "attachment_root": ATTACHMENT_ROOT,
        "run_start_ts": run_start_ts,
        "run_end_ts": run_end_ts,
        "duration_seconds": duration,
        "overall_clean": overall_clean,
        **manifest_stats,
        **s3_stats,
    }

    key = f"{VERIFY_PREFIX}/summary/{JOB_NAME}_{run_end_ts.replace(':', '-')}.json"
    try:
        boto3.client("s3").put_object(
            Bucket=VERIFY_BUCKET, Key=key,
            Body=json.dumps(summary, default=str).encode("utf-8"),
            ContentType="application/json",
        )
        logger.info(f"Wrote verification summary to s3://{VERIFY_BUCKET}/{key}")
    except Exception as e:  # noqa: BLE001
        logger.warn(f"Failed to write verification summary: {e}")

    logger.info(f"VERIFICATION {'PASSED' if overall_clean else 'FAILED'} -- see summary above / in S3.")

    job.commit()


if __name__ == "__main__":
    main()
